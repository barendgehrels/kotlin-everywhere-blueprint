# Copy to service/.env for npx wrangler dev (never in git). Deployed: npx wrangler secret put NAME
MAPTILER_API_KEY=
ANTHROPIC_API_KEY=
# Cloudflare's Turnstile test keys, which always pass. A real secret refuses the test token.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Overrides the var locally: the page /human_check of the native apps needs a test site key too
TURNSTILE_SITE_KEY=1x00000000000000000000AA
