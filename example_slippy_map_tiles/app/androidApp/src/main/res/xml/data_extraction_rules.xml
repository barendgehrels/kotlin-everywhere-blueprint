<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. The DataStore file holds the session's tokens: never backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="slippy.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="slippy.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
